{
  "name": "edytor-map",
  "private": true,
  "version": "0.3.0",
  "description": "Uniwersalny edytor map 3D w przeglądarce, sterowany plikiem schematu gry.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "npm install --no-audit --no-fund && vite --open",
    "dev": "vite",
    "prebuild": "npm install --no-audit --no-fund",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
